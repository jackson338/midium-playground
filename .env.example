# Copy to .env and fill locally. Do not commit real keys.
# .env.example is the committed template.

# OpenRouter — Qwen3.8 Flash (hosted Flash-Next). Writes commission objectives only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Midium Cloud. These are ScoutConfig.cloud_api_key and ScoutConfig.cloud_base_url.
# The default URL is INFERENCE_BASE_URL in unified_compute_engine/src/product.py.
# The benchmark grader uses this host and the model "Gemma 4 26B A4B".
MIDIUM_CLOUD_API_KEY=
MIDIUM_CLOUD_BASE_URL=https://api.midium.dev/

# Local Midium. The benchmark runs Gemma 4 E4B here.
MIDIUM_LOCAL_API_KEY=
MIDIUM_LOCAL_BASE_URL=

# Reader web_search. Same env name the UCE Brave client reads.
BRAVE_SEARCH_API_KEY=

# Optional. Raises the GitHub search rate limit while cloning a few hundred repos.
GITHUB_TOKEN=
